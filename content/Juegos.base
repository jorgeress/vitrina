formulas:
  # `nota` esta vacia en casi la mitad de las fichas, y el comparador de Bases
  # manda los vacios al principio cuando el orden es DESC: la galeria abria con
  # lo que no he puntuado. Esto los baja a -1 para que caigan al final.
  puntuacion: if(note.nota, note.nota, -1)
  # La nota que se pinta, que no es la que se ordena. Falta en 47 de las 90
  # fichas, y en una rejilla eso se nota: las tarjetas sin ella median una fila
  # menos y las filas de la galeria quedaban dentadas. El guion las iguala, y
  # dice ademas lo que es verdad -- que no la he puntuado -- con el mismo signo
  # que ya usan las tablas para una casilla vacia.
  nota: if(note.nota, note.nota, "—")
filters:
  and:
    - note.tipo == "juego"
properties:
  file.name:
    displayName: Título
  note.year:
    displayName: Año
  note.autor:
    displayName: Estudio
  note.nota:
    displayName: Nota
views:
  - type: cards
    name: Galería
    order:
      - file.name
      - note.autor
      - note.year
      - formula.nota
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
    image: note.portada
    cardSize: 220
    imageAspectRatio: 0.67
  - type: table
    name: Tabla
    order:
      - file.name
      - note.autor
      - note.year
      - note.nota
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
  - type: cards
    name: Favoritos
    filters:
      and:
        - note.favorito == true
    order:
      - file.name
      - note.autor
      - note.year
      - formula.nota
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
    image: note.portada
    cardSize: 220
    imageAspectRatio: 0.67
  # No hay vista de lo ya jugado: Galería ya los enseña, y con casi todo
  # jugado seria la misma lista con otro nombre. Lo que si hace falta
  # apartado es lo que queda, que es lo que esta pestaña enseña.
  #
  # Va por `estado`, como las otras cuatro secciones. Antes iba por `horas`, que
  # es lo que sabe Steam, pero eso ataba la pestaña a un campo que solo tenia
  # sentido viniendo de alli: un juego apuntado a mano no traia horas y caia
  # aqui aunque lo hubieras terminado. El estado lo pones tu, que eres el unico
  # que sabe si lo dejaste a medias.
  #
  # Y sin nota, ni pintada ni en el orden: no la tiene nada de lo que todavia no
  # has jugado, asi que la fila serian guiones y el orden un empate a -1 que
  # acabaria resolviendo el titulo igual. Se ordena por titulo directamente.
  - type: cards
    name: Por jugar
    filters:
      or:
        - note.estado == "pendiente"
        - note.estado == "en curso"
    order:
      - file.name
      - note.autor
      - note.year
    sort:
      - property: file.name
        direction: ASC
    image: note.portada
    cardSize: 220
    imageAspectRatio: 0.67
