# Lo ultimo que ha entrado, para la portada: es lo unico de ella que cambia de
# una semana a otra. Va por `alta`, que esta escrita en cada ficha; la fecha del
# fichero no vale, que un `git clone` las deja todas en la hora del clon.
filters:
  or:
    - note.type == "game"
    - note.type == "film"
    - note.type == "series"
    - note.type == "book"
    - note.type == "album"
formulas:
  nota: if(note.rating, note.rating, "—")
  seccion: if(note.type == "game", "Juegos", if(note.type == "film", "Películas", if(note.type == "series", "Series", if(note.type == "book", "Libros", "Música"))))
properties:
  file.name:
    displayName: Título
  note.author:
    displayName: Autoría
  formula.seccion:
    displayName: Sección
views:
  - type: cards
    name: Recién llegadas
    image: note.cover
    # Mezcla carteles 2:3 y discos cuadrados, como Favoritos, y por lo mismo:
    # ratio fijo para que la fila no salga dentada, y `contain` para que el
    # disco no pierda los lados.
    cardSize: 220
    imageAspectRatio: 0.67
    imageFit: contain
    limit: 12
    order:
      - file.name
      - formula.seccion
      - note.author
    sort:
      - property: note.added
        direction: DESC
      - property: file.name
        direction: ASC
