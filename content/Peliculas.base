formulas:
  # `nota` esta vacia en casi la mitad de las fichas, y el comparador de Bases
  # manda los vacios al principio cuando el orden es DESC: la galeria abria con
  # lo que no he puntuado. Esto los baja a -1 para que caigan al final.
  puntuacion: if(note.nota, note.nota, -1)
  # La nota que se pinta, que no es la que se ordena. Falta en 47 de las 90
  # fichas, y en una rejilla eso se nota: las tarjetas sin ella median una fila
  # menos y las filas de la galeria quedaban dentadas. El guion las iguala, y
  # dice ademas lo que es verdad -- que no la he puntuado -- con el mismo signo
  # que ya usan las tablas para una casilla vacia.
  nota: if(note.nota, note.nota, "—")
filters:
  and:
    - note.tipo == "peli"
properties:
  file.name:
    displayName: Título
  note.year:
    displayName: Año
  note.autor:
    displayName: Dirección
  note.nota:
    displayName: Nota
  note.estado:
    displayName: Estado
views:
  - type: cards
    name: Galería
    order:
      - file.name
      - note.autor
      - note.year
      - formula.nota
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
    image: note.portada
    cardSize: 220
    imageAspectRatio: 0.67
  - type: table
    name: Tabla
    order:
      - file.name
      - note.autor
      - note.year
      - note.nota
      - note.estado
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
  - type: cards
    name: Favoritos
    filters:
      and:
        - note.favorito == true
    order:
      - file.name
      - note.autor
      - note.year
      - formula.nota
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
    image: note.portada
    cardSize: 220
    imageAspectRatio: 0.67
  # Las dos mitades de `estado`, que la galeria enseña juntas y que aqui se
  # miran por separado: lo visto, y la lista de lo que queda. «Por ver» es la
  # watchlist de Letterboxd tal cual: su csv ya entra como `pendiente` y todo
  # lo demas como `terminado`, asi que la lista viene puesta del import.
  - type: cards
    name: Vistas
    filters:
      and:
        - note.estado == "terminado"
    order:
      - file.name
      - note.autor
      - note.year
      - formula.nota
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
    image: note.portada
    cardSize: 220
    imageAspectRatio: 0.67
  # "en curso" entra aqui: empezada no es terminada, y si se quedara fuera, la
  # serie que estoy viendo ahora no saldria en ninguna de las dos. "abandonado"
  # no, que eso ya no espera nada.
  #
  # Y sin nota, ni pintada ni en el orden: no la tiene nada de lo que todavia no
  # has visto, asi que la fila serian guiones y el orden un empate a -1 que
  # acabaria resolviendo el titulo igual. Se ordena por titulo directamente.
  - type: cards
    name: Por ver
    filters:
      or:
        - note.estado == "pendiente"
        - note.estado == "en curso"
    order:
      - file.name
      - note.autor
      - note.year
    sort:
      - property: file.name
        direction: ASC
    image: note.portada
    cardSize: 220
    imageAspectRatio: 0.67
