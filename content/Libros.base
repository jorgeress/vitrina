formulas:
  # `nota` esta vacia en casi la mitad de las fichas, y el comparador de Bases
  # manda los vacios al principio cuando el orden es DESC: la galeria abria con
  # lo que no he puntuado. Esto los baja a -1 para que caigan al final.
  puntuacion: if(note.nota, note.nota, -1)
filters:
  and:
    - note.tipo == "libro"
properties:
  file.name:
    displayName: Título
  note.year:
    displayName: Año
  note.autor:
    displayName: Autor
  note.nota:
    displayName: Nota
  note.estado:
    displayName: Estado
views:
  - type: cards
    name: Galería
    order:
      - file.name
      - note.autor
      - note.year
      - note.nota
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
    image: note.portada
    cardSize: 220
    imageAspectRatio: 0.67
  - type: table
    name: Tabla
    order:
      - file.name
      - note.autor
      - note.year
      - note.nota
      - note.estado
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
  - type: cards
    name: Favoritos
    filters:
      and:
        - note.favorito == true
    order:
      - file.name
      - note.autor
      - note.year
      - note.nota
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
    image: note.portada
    cardSize: 220
    imageAspectRatio: 0.67
