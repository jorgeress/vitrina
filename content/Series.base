filters:
  and:
    - note.type == "series"
formulas:
  puntuacion: if(note.rating, note.rating, -1)
  nota: if(note.rating, note.rating, "—")
properties:
  file.name:
    displayName: Título
  note.year:
    displayName: Año
  note.author:
    displayName: Creación
  note.rating:
    displayName: Nota
views:
  - type: cards
    name: Galería
    order:
      - file.name
      - author
      - year
      - formula.nota
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
    image: note.cover
    cardSize: 220
    imageAspectRatio: 0.67
  - type: table
    name: Tabla
    order:
      - file.name
      - author
      - year
      - rating
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
  - type: cards
    name: Favoritos
    filters:
      and:
        - note.favorite == true
    order:
      - file.name
      - author
      - year
      - formula.nota
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
    image: note.cover
    cardSize: 220
    imageAspectRatio: 0.67
  - type: cards
    name: Por ver
    filters:
      or:
        - note.status == "pending"
        - note.status == "in-progress"
    order:
      - file.name
      - author
      - year
    sort:
      - property: file.name
        direction: ASC
    image: note.cover
    cardSize: 220
    imageAspectRatio: 0.67
