filters:
  and:
    - note.tipo == "serie"
formulas:
  puntuacion: if(note.nota, note.nota, -1)
  nota: if(note.nota, note.nota, "—")
properties:
  file.name:
    displayName: Título
  note.year:
    displayName: Año
  note.autor:
    displayName: Creación
  note.nota:
    displayName: Nota
views:
  - type: cards
    name: Galería
    order:
      - file.name
      - autor
      - year
      - formula.nota
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
    image: note.portada
    cardSize: 220
    imageAspectRatio: 0.67
  - type: table
    name: Tabla
    order:
      - file.name
      - autor
      - year
      - nota
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
  - type: cards
    name: Favoritos
    filters:
      and:
        - note.favorito == true
    order:
      - file.name
      - autor
      - year
      - formula.nota
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
    image: note.portada
    cardSize: 220
    imageAspectRatio: 0.67
  - type: cards
    name: Por ver
    filters:
      or:
        - note.estado == "pendiente"
        - note.estado == "en curso"
    order:
      - file.name
      - autor
      - year
    sort:
      - property: file.name
        direction: ASC
    image: note.portada
    cardSize: 220
    imageAspectRatio: 0.67
