formulas:
  # `nota` esta vacia en casi la mitad de las fichas, y el comparador de Bases
  # manda los vacios al principio cuando el orden es DESC: la galeria abria con
  # lo que no he puntuado. Esto los baja a -1 para que caigan al final.
  puntuacion: if(note.nota, note.nota, -1)
filters:
  and:
    - note.favorito == true
properties:
  file.name:
    displayName: Título
  note.tipo:
    displayName: Tipo
  note.autor:
    displayName: Autor
  note.nota:
    displayName: Nota
  note.year:
    displayName: Año
views:
  - type: cards
    name: Todo junto
    image: note.portada
    cardSize: 200
    order:
      - file.name
      - note.autor
      - note.nota
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
  - type: board
    name: Por tipo
    groupBy:
      property: note.tipo
    order:
      - file.name
      - note.autor
      - note.nota
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
