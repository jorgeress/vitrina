formulas:
  # `nota` esta vacia en casi la mitad de las fichas, y el comparador de Bases
  # manda los vacios al principio cuando el orden es DESC: la galeria abria con
  # lo que no he puntuado. Esto los baja a -1 para que caigan al final.
  puntuacion: if(note.nota, note.nota, -1)
  # La nota que se pinta, que no es la que se ordena. Falta en 47 de las 90
  # fichas, y en una rejilla eso se nota: las tarjetas sin ella median una fila
  # menos y las filas de la galeria quedaban dentadas. El guion las iguala, y
  # dice ademas lo que es verdad -- que no la he puntuado -- con el mismo signo
  # que ya usan las tablas para una casilla vacia.
  nota: if(note.nota, note.nota, "—")
  # `tipo` guarda la clave, no el rotulo: agrupar por el crudo pintaba columnas
  # tituladas "peli" y "album". Los nombres de seccion viven aqui, en la vista,
  # y no en las noventa fichas.
  seccion: if(note.tipo == "juego", "Juegos", if(note.tipo == "peli", "Películas", if(note.tipo == "libro", "Libros", "Música")))
filters:
  and:
    - note.favorito == true
properties:
  file.name:
    displayName: Título
  note.tipo:
    displayName: Tipo
  # Es la unica pagina que mezcla los cuatro tipos: aqui el mismo campo es
  # estudio, direccion, autor y artista, asi que el rotulo tiene que valer
  # para los cuatro.
  note.autor:
    displayName: Autoría
  note.nota:
    displayName: Nota
  note.year:
    displayName: Año
views:
  - type: cards
    name: Todo junto
    image: note.portada
    # Las mismas medidas que las galerias de seccion: entrar en Favoritos no
    # deberia cambiar el tamaño de la tarjeta.
    cardSize: 220
    # Es la unica galeria que mezcla los cuatro tipos, y las caratulas no miden
    # igual: un cartel es 2:3 y la portada de un disco es cuadrada. Sin ratio,
    # el hueco de la imagen lo marca cada fichero, asi que un disco quedaba una
    # cuarta parte mas bajo que la pelicula de al lado y la fila salia dentada
    # --lo mismo que pasaba con la nota, y por lo mismo: lo que no mide igual
    # descuadra la rejilla--. Se fija el 2:3 de las secciones, que es lo que
    # tienen 15 de las 21.
    imageAspectRatio: 0.67
    # Y `contain`, que es lo que cambia respecto a las secciones: ahi todas las
    # caratulas ya son del ratio de su hueco y recortar no recorta nada. Aqui un
    # disco cuadrado en un hueco 2:3 perderia un tercio por los lados, que en
    # una portada de disco es justo donde esta el dibujo. Entra entero, con el
    # fondo de la tarjeta arriba y abajo.
    imageFit: contain
    order:
      - file.name
      - note.autor
      - note.year
      - formula.nota
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
  - type: board
    name: Por tipo
    groupBy:
      property: formula.seccion
    # Sin `file.name`: la vista de tablero no lo descarta como hace la de
    # tarjetas, y cada ficha repetia su titulo como si fuera un dato mas.
    order:
      - note.autor
      - note.year
      - note.nota
    sort:
      - property: formula.puntuacion
        direction: DESC
      - property: file.name
        direction: ASC
