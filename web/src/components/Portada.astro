---
import { ESTADOS, cartela, portada, quienFirma, ruta, titulo, transicion, type Obra } from "../lib/obras";

interface Props {
  obra: Obra;
  /** En las secciones la tarjeta lleva datos para que los filtros la muevan. */
  filtrable?: boolean;
  /** En una rejilla con varias secciones todas las tarjetas miden lo mismo:
   * el disco, cuadrado, va centrado sobre su propia portada desenfocada. */
  mixta?: boolean;
  /** La portada viaja a la ficha al abrirla. Solo donde la obra sale una
   * vez: el nombre de la transición tiene que ser único en la página. */
  viaja?: boolean;
  /** Una línea debajo en vez del año y el autor: «Por FromSoftware». */
  nota?: string;
  /** Las primeras de una página se cargan ya, las demás al acercarse. */
  prioridad?: boolean;
}

const { obra, filtrable = false, mixta = false, viaja = false, nota, prioridad = false } = Astro.props;
const d = obra.data;
const cuadrada = d.tipo === "album";
const imagen = portada(obra);
const nombre = titulo(obra);
const escrita = cartela(obra) !== null;
const quien = quienFirma(obra);
const carga = prioridad ? "eager" : "lazy";
const datos = filtrable
  ? {
      "data-titulo": nombre.toLowerCase(),
      "data-autor": quien.toLowerCase(),
      "data-estado": d.estado ?? "",
      "data-favorito": d.favorito ? "1" : "",
      "data-nota": d.nota ?? 0,
      "data-year": d.year ?? 0,
      "data-alta": d.alta?.getTime() ?? 0,
      "data-tags": (d.tags ?? []).join(" "),
      "data-cartela": escrita ? "1" : "",
    }
  : {};
const retirada = d.estado === "abandonado";
---

<a
  class:list={["portada", { retirada }]}
  href={ruta(obra)}
  style={`--seccion:var(--${d.tipo})`}
  title={retirada ? `${nombre} · ${ESTADOS.abandonado}` : undefined}
  {...datos}
>
  <div
    class:list={["marco", cuadrada && !mixta && "cuadrada"]}
    style={viaja ? `view-transition-name:${transicion(obra)}` : undefined}
  >
    {
      imagen && cuadrada && mixta ? (
        <>
          <img class="difuso" src={imagen} alt="" loading={carga} decoding="async" />
          <img class="centrada" src={imagen} alt="" loading={carga} decoding="async" />
        </>
      ) : imagen ? (
        <img src={imagen} alt="" loading={carga} decoding="async" />
      ) : (
        // Sin portada, una tarjeta con el título y el color de la sección en
        // vez de un hueco: se ve que falta, pero no parece un error.
        <span class="sin-imagen">
          <span class="sin-imagen-titulo">{nombre}</span>
          {quien && <span class="sin-imagen-autor">{quien}</span>}
        </span>
      )
    }
    {d.favorito && <span class="sello estrella" title="Lo mejor de lo mejor">★</span>}
    {d.nota && <span class="sello nota" title={`Nota: ${d.nota} de 10`}>{d.nota}</span>}
    {
      escrita && (
        <span class="sello escrita" title="Tiene cartela: está escrito por qué está aquí">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 3h12l4 6-10 13L2 9Z" />
            <path d="M2 9h20" />
          </svg>
        </span>
      )
    }
  </div>
  <p class="titulo">{nombre}</p>
  <p class="meta">{nota ?? [d.year, quien].filter(Boolean).join(" · ")}</p>
</a>

<style>
  .portada {
    display: block;
    min-width: 0;
  }
  .marco {
    position: relative;
    aspect-ratio: 2 / 3;
    border-radius: var(--radio);
    overflow: hidden;
    background: var(--caja-2);
    box-shadow: var(--sombra);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }
  .marco.cuadrada {
    aspect-ratio: 1;
  }
  .portada:hover .marco,
  .portada:focus-visible .marco {
    transform: translateY(-3px);
    box-shadow:
      0 0 0 2px var(--seccion),
      var(--sombra);
  }
  .portada:focus-visible {
    outline: none;
  }
  /* Lo retirado de la vitrina sigue a la vista, pero apagado. */
  .retirada .marco {
    filter: grayscale(0.85);
    opacity: 0.6;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .difuso {
    position: absolute;
    inset: 0;
    filter: blur(18px) saturate(1.2);
    transform: scale(1.3);
    opacity: 0.8;
  }
  .centrada {
    position: absolute;
    inset: 0;
    margin: auto;
    height: auto;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.4);
  }
  .sin-imagen {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    height: 100%;
    padding: 14px;
    background:
      radial-gradient(circle at 20% 15%, color-mix(in srgb, var(--seccion) 45%, transparent), transparent 60%),
      linear-gradient(160deg, color-mix(in srgb, var(--seccion) 25%, var(--caja-2)), var(--caja-2));
  }
  .sin-imagen-titulo {
    font-family: var(--rotulo);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.15;
  }
  .sin-imagen-autor {
    font-size: 0.8rem;
    color: var(--tenue);
  }
  .sello {
    position: absolute;
    top: 8px;
    display: grid;
    place-items: center;
    min-width: 26px;
    height: 26px;
    padding-inline: 6px;
    border-radius: 999px;
    background: rgb(15 14 16 / 0.72);
    color: #ece7dd;
    font-size: 0.8rem;
    font-weight: 700;
    backdrop-filter: blur(6px);
  }
  /* La estrella, en el dorado de la casa: el claro, que va sobre la portada. */
  .estrella {
    left: 8px;
    color: #e0c063;
  }
  .nota {
    right: 8px;
  }
  .escrita {
    top: auto;
    bottom: 8px;
    right: 8px;
  }
  .escrita svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linejoin: round;
  }
  .titulo {
    margin: 10px 0 0;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .meta {
    margin: 2px 0 0;
    font-size: 0.84rem;
    color: var(--tenue);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
