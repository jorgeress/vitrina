---
// Un gráfico de barras sencillo en HTML: columnas o barras tumbadas, una
// sola serie, con su tooltip al pasar el ratón o el foco y su tabla al lado
// para quien no vea el color o use lector de pantalla.

interface Props {
  datos: { etiqueta: string; valor: number; enlace?: string }[];
  /** Para que varios gráficos pequeños compartan escala. */
  maximo?: number;
  color?: string;
  tumbadas?: boolean;
  /** «juego»/«juegos», para el tooltip y la tabla. */
  una: string;
  varias: string;
  titulo: string;
}

const { datos, maximo = Math.max(1, ...datos.map((d) => d.valor)), color = "var(--enlace)", tumbadas = false, una, varias, titulo } = Astro.props;
const texto = (n: number) => `${n} ${n === 1 ? una : varias}`;
---

<figure class:list={["grafico", { tumbadas }]} style={`--color:${color}`}>
  <div class="barras" role="img" aria-label={`${titulo}: ${datos.map((d) => `${d.etiqueta}, ${texto(d.valor)}`).join("; ")}`}>
    {
      datos.map((d) => {
        const Etiqueta = d.enlace ? "a" : "div";
        return (
          <Etiqueta class="celda" href={d.enlace} tabindex={d.enlace ? undefined : 0}>
            {tumbadas && <span class="nombre">{d.etiqueta}</span>}
            <span class="pista">
              <span class="barra" style={`--v:${d.valor / maximo}`} />
            </span>
            {tumbadas ? <span class="valor">{d.valor}</span> : <span class="eje">{d.etiqueta}</span>}
            <span class="tip">
              {d.etiqueta}: {texto(d.valor)}
            </span>
          </Etiqueta>
        );
      })
    }
  </div>
  <details>
    <summary>Ver como tabla</summary>
    <table>
      <tbody>
        {
          datos.map((d) => (
            <tr>
              <th scope="row">{d.etiqueta}</th>
              <td>{texto(d.valor)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>
</figure>

<style>
  .grafico {
    margin: 0;
  }
  /* Columnas: cada celda es toda la columna, para que el ratón no tenga
     que acertar en una barra fina. */
  .barras {
    display: flex;
    align-items: stretch;
    gap: 2px;
    height: 140px;
    border-bottom: 1px solid var(--borde);
  }
  .celda {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    outline-offset: 2px;
  }
  .pista {
    flex: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .barra {
    display: block;
    width: min(100%, 26px);
    height: calc(var(--v) * 100%);
    min-height: 2px;
    background: var(--color);
    border-radius: 4px 4px 0 0;
    transition: opacity 0.15s ease;
  }
  .barras:hover .barra,
  .barras:focus-within .barra {
    opacity: 0.45;
  }
  .celda:hover .barra,
  .celda:focus-visible .barra {
    opacity: 1;
  }
  .eje {
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.75rem;
    color: var(--suave);
    white-space: nowrap;
  }
  .barras {
    margin-bottom: 26px;
  }
  .tip {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    z-index: 2;
    transform: translateX(-50%);
    padding: 5px 9px;
    border-radius: 6px;
    background: var(--texto);
    color: var(--fondo);
    font-size: 0.82rem;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.12s ease;
  }
  .celda:hover .tip,
  .celda:focus-visible .tip {
    opacity: 1;
  }

  /* Tumbadas: nombre, barra y valor en una fila. */
  .tumbadas .barras {
    flex-direction: column;
    height: auto;
    gap: 2px;
    border: 0;
    margin-bottom: 8px;
  }
  .tumbadas .celda {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    padding-block: 3px;
  }
  .tumbadas .nombre {
    flex: 0 0 38%;
    font-size: 0.92rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tumbadas .pista {
    align-items: center;
    justify-content: flex-start;
    height: 14px;
  }
  .tumbadas .barra {
    width: calc(var(--v) * 100%);
    height: 100%;
    min-width: 2px;
    border-radius: 0 4px 4px 0;
  }
  .tumbadas .valor {
    flex: 0 0 2.5em;
    text-align: right;
    font-size: 0.88rem;
    color: var(--tenue);
    font-variant-numeric: tabular-nums;
  }
  .tumbadas .tip {
    left: auto;
    right: 0;
    transform: none;
  }
  a.celda:hover .nombre {
    color: var(--enlace);
  }
  details {
    font-size: 0.85rem;
    color: var(--tenue);
  }
  summary {
    cursor: pointer;
  }
  table {
    margin-top: 8px;
    border-collapse: collapse;
  }
  th,
  td {
    padding: 3px 14px 3px 0;
    text-align: left;
    font-weight: 400;
  }
  th {
    color: var(--texto);
  }
</style>
