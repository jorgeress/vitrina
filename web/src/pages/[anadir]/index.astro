---
import Base from "../../layouts/Base.astro";
import { REPO } from "../../config";
import { t } from "../../i18n";

export const getStaticPaths = () => [{ params: { anadir: t.rutas.anadir } }];

const formulario = `${REPO}/issues/new?template=${t.plantillaIssue}`;
---

<Base titulo={t.anadirTitulo} descripcion={t.anadirDescripcion}>
  <div class="contenedor">
    <header class="titulo-pagina">
      <h1>{t.anadirTitulo}</h1>
      <p>{t.anadirSub}</p>
    </header>
    <form id="anadir" class="formulario" data-formulario={formulario}>
      <input type="url" name="enlace" required placeholder="https://letterboxd.com/film/…" aria-label={t.enlaceObra} />
      <button type="submit">{t.seguirGitHub}</button>
    </form>
    <p class="nota">{t.anadirNota}</p>
  </div>
</Base>

<script>
  // Lo que llega del menú Compartir trae el enlace en `url` o, según la app,
  // metido en el texto. Si hay uno, se va derecho al formulario.
  const form = document.getElementById("anadir") as HTMLFormElement;
  const destino = (enlace: string) => `${form.dataset.formulario}&enlace=${encodeURIComponent(enlace)}`;
  const p = new URLSearchParams(location.search);
  const compartido = [p.get("url"), p.get("text"), p.get("title")]
    .map((t) => t?.match(/https?:\/\/\S+/)?.[0])
    .find(Boolean);
  if (compartido) location.replace(destino(compartido));

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    location.href = destino(String(new FormData(form).get("enlace")));
  });
</script>

<style>
  .formulario {
    display: flex;
    gap: 10px;
    margin-top: 28px;
  }
  .formulario input {
    flex: 1;
    padding: 11px 14px;
    border: 1px solid var(--borde);
    border-radius: 8px;
    background: var(--caja);
    color: var(--texto);
    font: inherit;
  }
  .formulario button {
    padding: 11px 20px;
    border: 0;
    border-radius: 8px;
    background: var(--texto);
    color: var(--fondo);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .nota {
    margin-top: 20px;
    color: var(--tenue);
  }
  @media (max-width: 520px) {
    .formulario {
      flex-direction: column;
    }
  }
</style>
