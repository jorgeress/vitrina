---
import Base from "../../layouts/Base.astro";
import Portada from "../../components/Portada.astro";
import { t } from "../../i18n";
import { SECCIONES, cantidad, nombreTag, obras, piezas, porAprecio, rutaFija, slugQuartz, type Obra } from "../../lib/obras";

export async function getStaticPaths() {
  const todas = await obras();
  const porTag = new Map<string, Obra[]>();
  for (const o of todas) for (const tag of o.data.tags ?? []) porTag.set(tag, [...(porTag.get(tag) ?? []), o]);
  // La misma dirección que las páginas de tag de Quartz: /tags/action.
  return [...porTag].map(([tag, lista]) => ({ params: { tags: t.rutas.tags, tag: slugQuartz(tag) }, props: { tag, lista } }));
}

const { tag, lista } = Astro.props as { tag: string; lista: Obra[] };
const grupos = SECCIONES.map((s) => ({ seccion: s, obras: lista.filter((o) => o.data.type === s.tipo).sort(porAprecio) })).filter(
  (g) => g.obras.length > 0,
);
---

<Base titulo={nombreTag(tag)} descripcion={t.conElTag(piezas(lista.length), nombreTag(tag))}>
  <div class="contenedor">
    <header class="titulo-pagina">
      <a class="volver" href={rutaFija("tags")}>← {t.tags}</a>
      <h1>{nombreTag(tag)}</h1>
      <p>{t.enSalas(piezas(lista.length), cantidad(grupos.length, t.sala, t.salasPalabra))}</p>
    </header>
    {
      grupos.map(({ seccion, obras }) => (
        <section class="bloque" style={`--seccion:var(--${seccion.tipo})`}>
          {grupos.length > 1 && (
            <header>
              <h2>{seccion.nombre}</h2>
            </header>
          )}
          <div class="rejilla">
            {obras.map((o) => (
              <Portada obra={o} viaja />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .bloque {
    margin-block: 36px;
  }
  .bloque h2::before {
    content: "●";
    margin-right: 10px;
    font-size: 0.6em;
    vertical-align: 0.2em;
    color: var(--seccion);
  }
</style>
