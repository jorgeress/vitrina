---
import Base from "../../layouts/Base.astro";
import { t } from "../../i18n";
import { url } from "../../lib/obras";

export const getStaticPaths = () => [{ params: { comparar: t.rutas.comparar } }];

// Los textos que escribe el navegador van a la página como datos, en el
// idioma de la vitrina; las funciones no viajan, así que van con huecos.
const cliente = { ...t.cliente, noEncuentro: t.cliente.noEncuentro("{d}") };
---

<Base titulo={t.compararTitulo} descripcion={t.compararDescripcion}>
  <div class="contenedor">
    <header class="titulo-pagina">
      <h1>{t.compararTitulo}</h1>
      <p>{t.compararSub}</p>
    </header>

    <form id="formulario" class="formulario" data-propia={url("vitrine.json")}>
      <input
        type="url"
        name="con"
        placeholder="https://alguien.github.io/vitrina/"
        aria-label={t.direccionOtra}
        inputmode="url"
      />
      <button type="submit">{t.compararBoton}</button>
      <label class="fichero">
        {t.oFichero}
        <input type="file" name="fichero" accept=".json,application/json" />
      </label>
    </form>
    <p class="aviso" id="aviso" role="status"></p>

    <div id="resultado" hidden>
      <section class="afinidad">
        <p class="cifra"><span id="porcentaje"></span><small>%</small></p>
        <p id="resumen"></p>
      </section>
      <section class="bloque" data-bloque="favoritas">
        <header><h2>{t.mejorDeLosDos}</h2></header>
        <div class="rejilla"></div>
      </section>
      <section class="bloque" data-bloque="comunes">
        <header><h2>{t.compartis}</h2></header>
        <div class="rejilla"></div>
      </section>
      <section class="bloque" data-bloque="desacuerdos">
        <header>
          <div>
            <h2>{t.desacuerdos}</h2>
            <p>{t.desacuerdosSub}</p>
          </div>
        </header>
        <ul class="desacuerdos"></ul>
      </section>
      <section class="bloque" data-bloque="recomendaciones">
        <header>
          <div>
            <h2>{t.deAlli}</h2>
            <p>{t.deAlliSub}</p>
          </div>
        </header>
        <div class="rejilla"></div>
      </section>
    </div>
  </div>
  <script type="application/json" id="textos" set:html={JSON.stringify(cliente)} />
</Base>

<script>
  import { comparar, direccionesJSON, esVitrina, type Pieza, type Vitrina } from "../../lib/comparar";

  const formulario = document.getElementById("formulario") as HTMLFormElement;
  const aviso = document.getElementById("aviso")!;
  const resultado = document.getElementById("resultado")!;
  const propia = formulario.dataset.propia!;
  const T = JSON.parse(document.getElementById("textos")!.textContent!) as Record<string, string>;
  /** Un texto con sus huecos rellenos: «{n} piezas». */
  const decir = (clave: string, datos: Record<string, string | number> = {}) =>
    T[clave].replace(/\{(\w+)\}/g, (_, k) => String(datos[k] ?? ""));

  /** Un elemento con sus atributos y su contenido, siempre como texto: lo
   * que viene de otra vitrina no se mete nunca como HTML. */
  function el(etiqueta: string, atributos: Record<string, string> = {}, ...hijos: (Node | string)[]) {
    const nodo = document.createElement(etiqueta);
    for (const [k, v] of Object.entries(atributos)) nodo.setAttribute(k, v);
    nodo.append(...hijos);
    return nodo;
  }

  const segura = (direccion: string | null | undefined) => (direccion && /^https?:\/\//.test(direccion) ? direccion : "#");

  function tarjeta(p: Pieza, linea: string) {
    const marco = el("span", { class: "marco" });
    if (p.cover) marco.append(el("img", { src: segura(p.cover), alt: "", loading: "lazy" }));
    else marco.append(el("span", { class: "sin-imagen" }, p.title));
    return el("a", { class: "pieza", href: segura(p.url) }, marco, el("span", { class: "titulo" }, p.title), el("span", { class: "meta" }, linea));
  }

  function llenar(bloque: string, nodos: Node[]) {
    const seccion = resultado.querySelector<HTMLElement>(`[data-bloque="${bloque}"]`)!;
    seccion.hidden = nodos.length === 0;
    seccion.querySelector(".rejilla, ul")!.replaceChildren(...nodos);
  }

  async function bajar(direccion: string): Promise<Vitrina> {
    const respuesta = await fetch(direccion);
    if (!respuesta.ok) throw new Error(`${respuesta.status}`);
    const datos = await respuesta.json();
    if (!esVitrina(datos)) throw new Error("no es una vitrina");
    return datos;
  }

  /** La primera de las direcciones posibles que sea de verdad una vitrina. */
  async function buscar(candidatas: string[]): Promise<Vitrina> {
    for (const d of candidatas) {
      try {
        return await bajar(d);
      } catch {}
    }
    throw new Error("ninguna");
  }

  async function mostrar(suya: Vitrina) {
    let mia: Vitrina;
    try {
      mia = await bajar(propia);
    } catch {
      aviso.textContent = decir("noEncuentro", { d: propia });
      return;
    }
    // Las direcciones de vitrine.json son las publicadas. Las de esta vitrina
    // se pasan a este mismo sitio, para que también se vea en local o en una
    // copia que aún no esté publicada.
    const local = (d: string | null | undefined) => (d ? new URL(new URL(d).pathname, location.origin).href : d);
    mia.works = mia.works.map((p) => ({ ...p, url: local(p.url)!, cover: local(p.cover) }));

    const r = comparar(mia, suya);
    aviso.textContent = "";
    document.getElementById("porcentaje")!.textContent = String(Math.round(r.afinidad * 100));
    const piezas = (n: number) => (n === 1 ? decir("unaPieza") : decir("nPiezas", { n }));
    const estan = (n: number) => (n === 1 ? T.esta : T.estan);
    const total = r.comunes.length + r.soloMias.length + r.soloSuyas.length;
    document.getElementById("resumen")!.textContent = decir("resumen", {
      comunes: piezas(r.comunes.length),
      total,
      mias: r.soloMias.length,
      estanMias: estan(r.soloMias.length),
      suyas: r.soloSuyas.length,
      estanSuyas: estan(r.soloSuyas.length),
    });

    llenar("favoritas", r.favoritasDeLosDos.map((c) => tarjeta(c.mia, T.enLasDos)));
    llenar(
      "comunes",
      r.comunes.map((c) =>
        tarjeta(
          c.mia,
          c.mia.rating || c.suya.rating
            ? [c.mia.rating && `${T.aqui} ${c.mia.rating}`, c.suya.rating && `${T.alli} ${c.suya.rating}`].filter(Boolean).join(" · ")
            : [c.mia.year, c.mia.authors[0]].filter(Boolean).join(" · "),
        ),
      ),
    );
    llenar(
      "desacuerdos",
      r.desacuerdos.map((c) =>
        el(
          "li",
          {},
          el("a", { href: segura(c.mia.url) }, c.mia.title),
          el("span", { class: "notas" }, `${c.mia.rating} ${T.aqui} · ${c.suya.rating} ${T.alli}`),
        ),
      ),
    );
    llenar(
      "recomendaciones",
      r.recomendaciones
        .slice(0, 24)
        .map((p) => tarjeta(p, [p.favorite && T.deLoMejorDeAlli, p.rating && decir("un", { n: p.rating }), p.year].filter(Boolean).join(" · "))),
    );
    resultado.hidden = false;
  }

  async function compararCon(texto: string) {
    let candidatas: string[];
    try {
      candidatas = direccionesJSON(texto);
    } catch {
      aviso.textContent = T.noEsDireccion;
      return;
    }
    aviso.textContent = T.mirando;
    resultado.hidden = true;
    try {
      await mostrar(await buscar(candidatas));
    } catch {
      aviso.textContent = decir("noEncuentro", { d: texto });
    }
  }

  // Un fichero se lee aquí mismo, sin subirlo a ningún sitio: sirve para
  // comparar con alguien que no tiene la vitrina publicada, o con la tuya de
  // hace un año.
  const fichero = formulario.elements.namedItem("fichero") as HTMLInputElement;
  fichero.addEventListener("change", async () => {
    const elegido = fichero.files?.[0];
    if (!elegido) return;
    resultado.hidden = true;
    try {
      const datos = JSON.parse(await elegido.text());
      if (!esVitrina(datos)) throw new Error();
      history.replaceState(null, "", location.pathname);
      await mostrar(datos);
    } catch {
      aviso.textContent = T.noEsFichero;
    }
  });

  formulario.addEventListener("submit", (e) => {
    e.preventDefault();
    const con = String(new FormData(formulario).get("con") ?? "").trim();
    if (!con) return;
    history.replaceState(null, "", `?con=${encodeURIComponent(con)}`);
    compararCon(con);
  });

  const inicial = new URLSearchParams(location.search).get("con");
  if (inicial) {
    (formulario.elements.namedItem("con") as HTMLInputElement).value = inicial;
    compararCon(inicial);
  }
</script>

<style>
  .formulario {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
  }
  .formulario input[type="url"] {
    flex: 1;
    padding: 11px 14px;
    border: 1px solid var(--borde);
    border-radius: 8px;
    background: var(--caja);
    color: var(--texto);
    font: inherit;
  }
  .formulario button {
    padding: 11px 20px;
    border: 0;
    border-radius: 8px;
    background: var(--texto);
    color: var(--fondo);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  /* El fichero es la otra manera de comparar, más discreta: debajo, en
     pequeño, para quien no tenga la otra vitrina publicada. */
  .fichero {
    display: flex;
    flex-basis: 100%;
    align-items: center;
    gap: 10px;
    color: var(--tenue);
    font-size: 0.92rem;
  }
  .fichero input {
    font: inherit;
    color: var(--tenue);
  }
  .aviso {
    min-height: 1.5em;
    color: var(--tenue);
  }
  .afinidad {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 32px;
    padding: 24px 28px;
    border-radius: var(--radio);
    background: var(--caja);
    border: 1px solid var(--borde);
  }
  .cifra {
    margin: 0;
    font-family: var(--rotulo);
    font-size: 4rem;
    font-weight: 600;
    line-height: 1;
  }
  .cifra small {
    font-size: 0.45em;
    color: var(--tenue);
  }
  .afinidad p:last-child {
    margin: 0;
    color: var(--tenue);
    font-size: 1.05rem;
  }
  #resultado :global(.pieza) {
    display: block;
    min-width: 0;
  }
  #resultado :global(.marco) {
    display: block;
    aspect-ratio: 2 / 3;
    border-radius: var(--radio);
    overflow: hidden;
    background: var(--caja-2);
    box-shadow: var(--sombra);
  }
  #resultado :global(.marco img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #resultado :global(.sin-imagen) {
    display: flex;
    align-items: flex-end;
    height: 100%;
    padding: 12px;
    font-family: var(--rotulo);
    font-weight: 600;
  }
  #resultado :global(.titulo) {
    display: block;
    margin-top: 10px;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.3;
  }
  #resultado :global(.meta) {
    display: block;
    color: var(--tenue);
    font-size: 0.84rem;
  }
  .desacuerdos {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .desacuerdos :global(li) {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--borde);
  }
  .desacuerdos :global(a) {
    font-weight: 600;
  }
  .desacuerdos :global(.notas) {
    color: var(--tenue);
  }
  @media (max-width: 520px) {
    .formulario {
      flex-direction: column;
    }
    .afinidad {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
</style>
