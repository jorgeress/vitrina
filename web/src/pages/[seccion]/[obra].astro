---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Portada from "../../components/Portada.astro";
import {
  ESTADOS,
  autores,
  autoresRepetidos,
  cartela,
  fuentes,
  mayuscula,
  nombreTag,
  obras,
  porAlta,
  portada,
  relacionadas,
  ruta,
  rutaAutor,
  slugsAutores,
  rutaTag,
  seccionDe,
  slugObra,
  titulo,
  transicion,
  url,
  type Obra,
  type Vecina,
} from "../../lib/obras";

export async function getStaticPaths() {
  const todas = await obras();
  return todas.map((obra) => ({
    params: { seccion: seccionDe(obra.data.tipo).slug, obra: slugObra(obra) },
    props: { obra, todas },
  }));
}

const { obra, todas } = Astro.props as { obra: Obra; todas: Obra[] };
const d = obra.data;
const seccion = seccionDe(d.tipo);
const nombre = titulo(obra);
const imagen = portada(obra);
const { Content } = await render(obra);
const cercanas = relacionadas(obra, todas);
const conPagina = autoresRepetidos(todas);
const slugs = await slugsAutores();
const quienes = autores(obra);
const enlaces = fuentes(obra);
const escrita = cartela(obra);
// Anterior y siguiente dentro de la sala, en el orden en que entraron: el
// mismo de la rejilla, así que pasar de una a otra es recorrerla.
const sala = todas.filter((o) => o.data.tipo === d.tipo).sort(porAlta);
const posicion = sala.findIndex((o) => o.id === obra.id);
const anterior = sala[posicion - 1];
const siguiente = sala[posicion + 1];

// Lo que leen los buscadores: qué es la obra y, si hay nota o cartela, una
// reseña mía con ellas.
const TIPOS_SCHEMA = { juego: "VideoGame", peli: "Movie", serie: "TVSeries", libro: "Book", album: "MusicAlbum" } as const;
// Quien firma un disco es un grupo y un juego lo firma un estudio; lo demás,
// personas.
const TIPO_CREADOR = { album: "MusicGroup", juego: "Organization" } as Record<string, string>;
const creadores = quienes.map((n) => ({ "@type": TIPO_CREADOR[d.tipo] ?? "Person", name: n }));
const datosEstructurados = {
  "@context": "https://schema.org",
  "@type": TIPOS_SCHEMA[d.tipo],
  name: nombre,
  ...(imagen && { image: new URL(imagen, Astro.site).href }),
  ...(d.year && { datePublished: String(d.year) }),
  ...(creadores.length && (d.tipo === "album" ? { byArtist: creadores } : d.tipo === "peli" ? { director: creadores } : { author: creadores })),
  ...(d.tags?.length && { genre: d.tags.map(nombreTag) }),
  ...((d.nota || escrita) && {
    review: {
      "@type": "Review",
      author: { "@type": "Person", name: "jorgeress" },
      ...(d.nota && { reviewRating: { "@type": "Rating", ratingValue: d.nota, bestRating: 10, worstRating: 1 } }),
      ...(escrita && { reviewBody: escrita }),
    },
  }),
};

const resumen = escrita ?? `${nombre}${d.year ? ` (${d.year})` : ""}, en la sala de ${seccion.nombre.toLowerCase()} de la vitrina.`;

/** Por qué está unida: el autor que comparten o sus dos tags más raros. */
function motivo(v: Vecina): string {
  const [primero, segundo] = v.motivos;
  if (!primero) return "";
  if (quienes.includes(primero)) return `También de ${primero}`;
  return [primero, segundo].filter(Boolean).map((t) => nombreTag(t!)).join(" · ");
}
---

<Base titulo={nombre} descripcion={resumen} imagen={imagen} activa={seccion.slug}>
  <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />
  <article style={`--seccion:var(--${d.tipo})`} data-pagefind-body>
    <header class="escaparate">
      {imagen && <div class="fondo" style={`background-image:url('${imagen}')`} aria-hidden="true" />}
      <div class="contenedor dentro">
        <div
          class:list={["cubierta", d.tipo === "album" && "cuadrada", d.estado === "abandonado" && "retirada"]}
          style={`view-transition-name:${transicion(obra)}`}
        >
          {
            imagen ? (
              <img src={imagen} alt={`Portada de ${nombre}`} data-pagefind-meta="image[src]" />
            ) : (
              <span class="sin-imagen">{nombre}</span>
            )
          }
        </div>
        <div class="datos">
          <a class="sala" href={url(`${seccion.slug}/`)} data-pagefind-filter="sala">{seccion.nombre}</a>
          <h1 data-pagefind-meta="title">{nombre}</h1>
          <p class="autor">
            {
              // Cada autor por separado, enlazado si tiene página: en «QLOC,
              // FromSoftware, Inc.» solo FromSoftware la tiene.
              quienes.map((a, i) => (
                <>
                  {i > 0 && (i === quienes.length - 1 ? " y " : ", ")}
                  {conPagina.has(a) ? <a href={rutaAutor(a, slugs)}>{a}</a> : <span>{a}</span>}
                </>
              ))
            }
            {quienes.length > 0 && d.year && <span class="punto"> · </span>}
            {d.year}
          </p>
          <div class="sellos">
            {d.favorito && <a class="sello dorado" href={url("favoritos/")}>★ Lo mejor de lo mejor</a>}
            {d.nota && <span class="sello">{d.nota}<small>/10</small></span>}
            {d.estado && <span class="sello">{ESTADOS[d.estado]}</span>}
            {
              d.alta && (
                <span class="sello tenue">
                  En la vitrina desde {d.alta.toLocaleDateString("es-ES", { month: "long", year: "numeric", timeZone: "UTC" })}
                </span>
              )
            }
          </div>
          {
            (d.tags?.length ?? 0) > 0 && (
              <div class="tags">
                {d.tags!.map((t) => (
                  <a class="chip" href={rutaTag(t)}>
                    {nombreTag(t)}
                  </a>
                ))}
              </div>
            )
          }
          <p class="fuentes">
            {enlaces.map((f) => (
              <a href={f.href} rel="noopener">
                {f.nombre} ↗
              </a>
            ))}
            <button type="button" class="compartir" id="compartir" hidden data-titulo={nombre}>
              Compartir
            </button>
          </p>
        </div>
      </div>
    </header>

    <div class="contenedor texto">
      <Content />
    </div>
  </article>


  {
    cercanas.length > 0 && (
      <section class="contenedor bloque" aria-labelledby="t-conectada">
        <header>
          <div>
            <h2 id="t-conectada">Conectada con</h2>
            <p>Lo que tiene en común con otras piezas de la vitrina.</p>
          </div>
          <a class="ver-todo" href={url(`constelacion/?foco=${encodeURIComponent(obra.id)}`)}>
            Verla en la constelación →
          </a>
        </header>
        <div class="rejilla">
          {cercanas.map((v) => (
            <Portada obra={v.obra} mixta nota={motivo(v)} />
          ))}
        </div>
      </section>
    )
  }

  <nav class="contenedor pasos" aria-label={`Más de ${seccion.nombre}`}>
    {
      anterior ? (
        <a href={ruta(anterior)} rel="prev" id="anterior">
          <small>← Anterior</small>
          {titulo(anterior)}
        </a>
      ) : (
        <span />
      )
    }
    {
      siguiente && (
        <a href={ruta(siguiente)} rel="next" id="siguiente" class="derecha">
          <small>Siguiente →</small>
          {titulo(siguiente)}
        </a>
      )
    }
  </nav>
</Base>

<script>
  // Compartir con lo que tenga el sistema (en el móvil, su menú); si no hay,
  // copiar el enlace.
  const boton = document.getElementById("compartir") as HTMLButtonElement;
  if (navigator.share || navigator.clipboard) {
    boton.hidden = false;
    boton.addEventListener("click", async () => {
      const datos = { title: boton.dataset.titulo, url: location.href.split("?")[0] };
      try {
        if (navigator.share) await navigator.share(datos);
        else {
          await navigator.clipboard.writeText(datos.url);
          boton.textContent = "Enlace copiado";
          setTimeout(() => (boton.textContent = "Compartir"), 2000);
        }
      } catch {}
    });
  }

  // Las flechas del teclado pasan a la anterior y la siguiente de la sala.
  document.addEventListener("keydown", (e) => {
    if ((e.target as HTMLElement).closest("input, textarea, select") || e.metaKey || e.ctrlKey || e.altKey) return;
    const destino = e.key === "ArrowLeft" ? "anterior" : e.key === "ArrowRight" ? "siguiente" : null;
    const enlace = destino && (document.getElementById(destino) as HTMLAnchorElement | null);
    if (enlace) location.href = enlace.href;
  });
</script>

<style>
  .escaparate {
    position: relative;
    overflow: hidden;
    padding-block: 52px;
    border-bottom: 1px solid var(--borde);
  }
  /* La propia portada, desenfocada, hace de fondo: cada ficha tiene su luz
     sin elegirla a mano, como una pieza iluminada dentro de su caja. */
  .fondo {
    position: absolute;
    inset: -40px;
    background-size: cover;
    background-position: center;
    filter: blur(52px) saturate(1.2);
    opacity: 0.3;
  }
  .dentro {
    position: relative;
    display: flex;
    gap: 44px;
    align-items: flex-end;
  }
  .cubierta {
    flex: none;
    width: 250px;
    aspect-ratio: 2 / 3;
    border-radius: var(--radio);
    overflow: hidden;
    background: var(--caja-2);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.45);
  }
  .cubierta.cuadrada {
    width: 290px;
    aspect-ratio: 1;
  }
  .cubierta.retirada {
    filter: grayscale(0.85);
  }
  .cubierta img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sin-imagen {
    display: flex;
    align-items: flex-end;
    height: 100%;
    padding: 20px;
    font-family: var(--rotulo);
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1.1;
    background:
      radial-gradient(circle at 20% 15%, color-mix(in srgb, var(--seccion) 45%, transparent), transparent 60%),
      linear-gradient(160deg, color-mix(in srgb, var(--seccion) 25%, var(--caja-2)), var(--caja-2));
  }
  .sala {
    font-family: var(--rotulo);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--tenue);
  }
  .sala::before {
    content: "●";
    margin-right: 8px;
    color: var(--seccion);
  }
  .sala:hover {
    color: var(--texto);
  }
  h1 {
    margin-top: 10px;
    font-size: clamp(2rem, 5vw, 3.3rem);
    line-height: 1.08;
    overflow-wrap: anywhere;
  }
  .autor {
    margin: 12px 0 0;
    font-size: 1.15rem;
    color: var(--tenue);
  }
  .autor a {
    color: var(--texto);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--texto) 30%, transparent);
    text-underline-offset: 4px;
  }
  .autor a:hover {
    text-decoration-color: currentColor;
  }
  .sellos {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .sello {
    padding: 5px 13px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--caja) 75%, transparent);
    border: 1px solid var(--borde);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .sello small {
    color: var(--tenue);
    font-weight: 400;
  }
  .sello.dorado {
    color: var(--dorado);
    border-color: color-mix(in srgb, var(--dorado) 45%, transparent);
  }
  .sello.tenue {
    color: var(--tenue);
    font-weight: 400;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  .fuentes {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin: 16px 0 0;
    font-size: 0.92rem;
  }
  .fuentes a {
    color: var(--enlace);
  }
  .fuentes a:hover {
    color: var(--texto);
  }
  .compartir {
    padding: 0;
    border: 0;
    background: none;
    color: var(--enlace);
    font: inherit;
    cursor: pointer;
  }
  .compartir:hover {
    color: var(--texto);
  }
  .pasos {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--borde);
  }
  .pasos a {
    display: flex;
    flex-direction: column;
    max-width: 45%;
    font-weight: 600;
  }
  .pasos a:hover {
    color: var(--enlace);
  }
  .pasos small {
    color: var(--tenue);
    font-weight: 400;
  }
  .pasos .derecha {
    text-align: right;
    margin-left: auto;
  }
  .texto {
    max-width: 760px;
    padding-top: 44px;
  }
  .texto :global(h2) {
    margin: 36px 0 12px;
    font-family: var(--rotulo);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .texto :global(ol) {
    columns: 2;
    column-gap: 40px;
    color: var(--tenue);
    padding-left: 1.6em;
  }
  .texto :global(ol li) {
    break-inside: avoid;
  }
  @media (max-width: 680px) {
    .escaparate {
      padding-block: 28px;
    }
    .dentro {
      flex-direction: column;
      align-items: flex-start;
      gap: 22px;
    }
    .cubierta {
      width: 160px;
    }
    .cubierta.cuadrada {
      width: 200px;
    }
    .texto :global(ol) {
      columns: 1;
    }
  }
</style>
