---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Portada from "../../components/Portada.astro";
import { DUENO } from "../../config";
import { t } from "../../i18n";
import {
  autores,
  autoresRepetidos,
  cartela,
  colorPortada,
  fechaParcial,
  fuentes,
  grupos,
  idSpotify,
  idYoutube,
  marcas,
  mesYAño,
  nombreTag,
  obras,
  porAlta,
  portada,
  relacionadas,
  relaciones,
  ruta,
  rutaAutor,
  rutaFija,
  rutaGrupo,
  slugsAutores,
  rutaTag,
  seccionDe,
  slugObra,
  tarjeta,
  titulo,
  transicion,
  url,
  type Obra,
  type Tipo,
  type Vecina,
} from "../../lib/obras";

export async function getStaticPaths() {
  const todas = await obras();
  return todas.map((obra) => ({
    params: { seccion: seccionDe(obra.data.type).slug, obra: slugObra(obra) },
    props: { obra, todas },
  }));
}

const { obra, todas } = Astro.props as { obra: Obra; todas: Obra[] };
const d = obra.data;
const seccion = seccionDe(d.type);
const nombre = titulo(obra);
const imagen = portada(obra);
const { Content } = await render(obra);
const cercanas = relacionadas(obra, todas);
const conPagina = autoresRepetidos(todas);
const slugs = await slugsAutores();
const quienes = autores(obra);
const enlaces = fuentes(obra);
const escrita = cartela(obra);
// Anterior y siguiente dentro de la sala, en el orden en que entraron: el
// mismo de la rejilla, así que pasar de una a otra es recorrerla.
const sala = todas.filter((o) => o.data.type === d.type).sort(porAlta);
const posicion = sala.findIndex((o) => o.id === obra.id);
const anterior = sala[posicion - 1];
const siguiente = sala[posicion + 1];

// Lo que leen los buscadores: qué es la obra y, si hay nota o cartela, una
// reseña mía con ellas.
const TIPOS_SCHEMA = { game: "VideoGame", film: "Movie", series: "TVSeries", book: "Book", album: "MusicAlbum" } as Record<string, string>;
// Quien firma un disco es un grupo y un juego lo firma un estudio; lo demás,
// personas.
const TIPO_CREADOR = { album: "MusicGroup", game: "Organization" } as Record<string, string>;
const creadores = quienes.map((n) => ({ "@type": TIPO_CREADOR[d.type] ?? "Person", name: n }));
const datosEstructurados = {
  "@context": "https://schema.org",
  "@type": TIPOS_SCHEMA[d.type],
  name: nombre,
  ...(imagen && { image: new URL(imagen, Astro.site).href }),
  ...(d.year && { datePublished: String(d.year) }),
  ...(creadores.length && (d.type === "album" ? { byArtist: creadores } : d.type === "film" ? { director: creadores } : { author: creadores })),
  ...(d.tags?.length && { genre: d.tags.map(nombreTag) }),
  ...((d.rating || escrita) && {
    review: {
      "@type": "Review",
      author: { "@type": "Person", name: DUENO },
      ...(d.rating && { reviewRating: { "@type": "Rating", ratingValue: d.rating, bestRating: 10, worstRating: 1 } }),
      ...(escrita && { reviewBody: escrita }),
    },
  }),
};

const resumen = escrita ?? t.resumenFicha(`${nombre}${d.year ? ` (${d.year})` : ""}`, seccion.nombre);
const tinte = await colorPortada(obra);
const historia = relaciones(obra, todas);
const disco = idSpotify(d.spotify);
const video = idYoutube(d.trailer);
const suyos = (await grupos()).filter((g) => g.obras.some((o) => o.id === obra.id));
const marcadas = marcas(obra);

/** Por qué está unida: el autor que comparten o sus dos tags más raros. */
function motivo(v: Vecina): string {
  const [primero, segundo] = v.motivos;
  if (!primero) return "";
  if (quienes.includes(primero)) return t.tambienDe(primero);
  return [primero, segundo].filter(Boolean).map((t) => nombreTag(t!)).join(" · ");
}
---

<Base titulo={nombre} descripcion={resumen} imagen={tarjeta(obra)} activa={seccion.slug}>
  <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />
  <article style={`--seccion:var(--${d.type})${tinte ? `;--tinte:${tinte}` : ""}`} class:list={[tinte && "tenida"]} data-pagefind-body>
    <header class="escaparate">
      {imagen && <div class="fondo" style={`background-image:url('${imagen}')`} aria-hidden="true" />}
      <div class="contenedor dentro">
        <div
          class:list={["cubierta", d.type === "album" && "cuadrada", d.status === "dropped" && "retirada"]}
          style={`view-transition-name:${transicion(obra)}`}
        >
          {
            imagen ? (
              <img src={imagen} alt={t.portadaDe(nombre)} data-pagefind-meta="image[src]" />
            ) : (
              <span class="sin-imagen">{nombre}</span>
            )
          }
        </div>
        <div class="datos">
          <a class="sala" href={url(`${seccion.slug}/`)} data-pagefind-filter="sala">{seccion.nombre}</a>
          <h1 data-pagefind-meta="title">{nombre}</h1>
          <p class="autor">
            {
              // Cada autor por separado, enlazado si tiene página: en «QLOC,
              // FromSoftware, Inc.» solo FromSoftware la tiene.
              quienes.map((a, i) => (
                <>
                  {i > 0 && (i === quienes.length - 1 ? ` ${t.y} ` : ", ")}
                  {conPagina.has(a) ? <a href={rutaAutor(a, slugs)}>{a}</a> : <span>{a}</span>}
                </>
              ))
            }
            {quienes.length > 0 && d.year && <span class="punto"> · </span>}
            {d.year}
          </p>
          <div class="sellos">
            {marcadas.map((m) => <span class="sello marca">{t[m]}</span>)}
            {d.favorite && <a class="sello dorado" href={rutaFija("favoritos")}>★ {t.mejor}</a>}
            {d.rating && <span class="sello">{d.rating}<small>/10</small></span>}
            {d.status && <span class="sello">{t.estados[d.status]}</span>}
            {d.times && d.times > 1 && <span class="sello">{t.veces(d.type as Tipo, d.times)}</span>}
            {
              d.finished_on && (
                <a class="sello" href={rutaFija("anuario", `${d.finished_on.slice(0, 4)}/`)}>
                  {t.terminadaEn(fechaParcial(d.finished_on))}
                </a>
              )
            }
            {d.added && <span class="sello tenue">{t.desde(mesYAño(d.added))}</span>}
          </div>
          {
            (d.tags?.length ?? 0) > 0 && (
              <div class="tags">
                {d.tags!.map((t) => (
                  <a class="chip" href={rutaTag(t)}>
                    {nombreTag(t)}
                  </a>
                ))}
              </div>
            )
          }
          {
            suyos.length > 0 && (
              <p class="grupos" aria-label={t.enGrupos}>
                {suyos.map((g) => (
                  <a class="chip grupo" href={rutaGrupo(g)}>
                    ◇ {g.nombre}
                  </a>
                ))}
              </p>
            )
          }
          {
            (disco || video) && (
              <p class="reproducir" data-pagefind-ignore>
                {disco && (
                  <button type="button" class="tocar" id="escuchar" aria-controls="spotify" aria-expanded="false" title={t.alPulsar("Spotify")}>
                    {t.escuchar}
                  </button>
                )}
                {video && (
                  <button type="button" class="tocar" id="ver-trailer" title={t.alPulsar("YouTube")}>
                    {t.verTrailer}
                  </button>
                )}
              </p>
            )
          }
          {
            // El iframe se pone al pulsar, no antes: hasta entonces Spotify no
            // sabe que alguien ha abierto la ficha.
            disco && (
              <div
                class="spotify"
                id="spotify"
                hidden
                data-src={`https://open.spotify.com/embed/album/${disco}?utm_source=generator`}
                data-titulo={nombre}
              />
            )
          }
          <p class="fuentes">
            {enlaces.map((f) => (
              <a href={f.href} rel="noopener">
                {f.nombre} ↗
              </a>
            ))}
            <button type="button" class="compartir" id="compartir" hidden data-titulo={nombre} data-compartir={t.compartir} data-copiado={t.copiado}>
              {t.compartir}
            </button>
          </p>
        </div>
      </div>
    </header>

    <div class="contenedor texto">
      <Content />
    </div>
  </article>

  {
    video && (
      <dialog class="trailer" id="trailer" aria-label={t.verTrailer.replace(/^▶\s*/, "")} data-src={`https://www.youtube-nocookie.com/embed/${video}?autoplay=1&rel=0`}>
        <form method="dialog">
          <button class="cerrar" aria-label={t.cerrar}>×</button>
        </form>
        <div class="pantalla" />
      </dialog>
    )
  }

  {
    historia.length > 0 && (
      <section class="contenedor bloque" aria-labelledby="t-historia">
        <header>
          <div>
            <h2 id="t-historia">{t.mismaHistoria}</h2>
            <p>{t.mismaHistoriaSub}</p>
          </div>
        </header>
        <div class="rejilla">
          {historia.map((r) => (
            <Portada obra={r.obra} mixta nota={t.relaciones[r.tipo]} />
          ))}
        </div>
      </section>
    )
  }


  {
    cercanas.length > 0 && (
      <section class="contenedor bloque" aria-labelledby="t-conectada">
        <header>
          <div>
            <h2 id="t-conectada">{t.conectada}</h2>
            <p>{t.conectadaSub}</p>
          </div>
          <a class="ver-todo" href={rutaFija("constelacion", `?foco=${encodeURIComponent(obra.id)}`)}>
            {t.enConstelacion}
          </a>
        </header>
        <div class="rejilla">
          {cercanas.map((v) => (
            <Portada obra={v.obra} mixta nota={motivo(v)} />
          ))}
        </div>
      </section>
    )
  }

  <nav class="contenedor pasos" aria-label={t.masDe(seccion.nombre)}>
    {
      anterior ? (
        <a href={ruta(anterior)} rel="prev" id="anterior">
          <small>{t.anterior}</small>
          {titulo(anterior)}
        </a>
      ) : (
        <span />
      )
    }
    {
      siguiente && (
        <a href={ruta(siguiente)} rel="next" id="siguiente" class="derecha">
          <small>{t.siguiente}</small>
          {titulo(siguiente)}
        </a>
      )
    }
  </nav>
</Base>

<script>
  // Compartir con lo que tenga el sistema (en el móvil, su menú); si no hay,
  // copiar el enlace.
  const boton = document.getElementById("compartir") as HTMLButtonElement;
  if (navigator.share || navigator.clipboard) {
    boton.hidden = false;
    boton.addEventListener("click", async () => {
      const datos = { title: boton.dataset.titulo, url: location.href.split("?")[0] };
      try {
        if (navigator.share) await navigator.share(datos);
        else {
          await navigator.clipboard.writeText(datos.url);
          boton.textContent = boton.dataset.copiado!;
          setTimeout(() => (boton.textContent = boton.dataset.compartir!), 2000);
        }
      } catch {}
    });
  }

  // El reproductor: el disco se despliega debajo de los datos y el tráiler se
  // abre encima de la página. Los dos se cargan al pulsar, no antes.
  const escuchar = document.getElementById("escuchar");
  const spotify = document.getElementById("spotify");
  escuchar?.addEventListener("click", () => {
    if (!spotify) return;
    if (!spotify.firstChild) {
      const marco = document.createElement("iframe");
      marco.src = spotify.dataset.src!;
      marco.title = `Spotify: ${spotify.dataset.titulo}`;
      marco.allow = "autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture";
      marco.loading = "lazy";
      spotify.append(marco);
    }
    spotify.hidden = !spotify.hidden;
    escuchar.setAttribute("aria-expanded", String(!spotify.hidden));
  });

  const trailer = document.getElementById("trailer") as HTMLDialogElement | null;
  document.getElementById("ver-trailer")?.addEventListener("click", () => {
    if (!trailer) return;
    const pantalla = trailer.querySelector(".pantalla")!;
    const marco = document.createElement("iframe");
    marco.src = trailer.dataset.src!;
    marco.title = trailer.getAttribute("aria-label")!;
    marco.allow = "autoplay; encrypted-media; fullscreen; picture-in-picture";
    marco.allowFullscreen = true;
    pantalla.replaceChildren(marco);
    trailer.showModal();
  });
  // Al cerrarlo se quita el vídeo, que si no seguiría sonando detrás.
  trailer?.addEventListener("close", () => trailer.querySelector(".pantalla")!.replaceChildren());
  trailer?.addEventListener("click", (e) => {
    if (e.target === trailer) trailer.close();
  });

  // Las flechas del teclado pasan a la anterior y la siguiente de la sala.
  document.addEventListener("keydown", (e) => {
    if ((e.target as HTMLElement).closest("input, textarea, select") || e.metaKey || e.ctrlKey || e.altKey) return;
    const destino = e.key === "ArrowLeft" ? "anterior" : e.key === "ArrowRight" ? "siguiente" : null;
    const enlace = destino && (document.getElementById(destino) as HTMLAnchorElement | null);
    if (enlace) location.href = enlace.href;
  });
</script>

<style>
  .escaparate {
    position: relative;
    overflow: hidden;
    padding-block: 52px;
    border-bottom: 1px solid var(--borde);
  }
  /* La propia portada, desenfocada, hace de fondo: cada ficha tiene su luz
     sin elegirla a mano, como una pieza iluminada dentro de su caja. */
  .fondo {
    position: absolute;
    inset: -40px;
    background-size: cover;
    background-position: center;
    filter: blur(52px) saturate(1.2);
    opacity: 0.3;
  }
  .dentro {
    position: relative;
    display: flex;
    gap: 44px;
    align-items: flex-end;
  }
  .cubierta {
    flex: none;
    width: 250px;
    aspect-ratio: 2 / 3;
    border-radius: var(--radio);
    overflow: hidden;
    background: var(--caja-2);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.45);
  }
  .cubierta.cuadrada {
    width: 290px;
    aspect-ratio: 1;
  }
  .cubierta.retirada {
    filter: grayscale(0.85);
  }
  .cubierta img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sin-imagen {
    display: flex;
    align-items: flex-end;
    height: 100%;
    padding: 20px;
    font-family: var(--rotulo);
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1.1;
    background:
      radial-gradient(circle at 20% 15%, color-mix(in srgb, var(--seccion) 45%, transparent), transparent 60%),
      linear-gradient(160deg, color-mix(in srgb, var(--seccion) 25%, var(--caja-2)), var(--caja-2));
  }
  .sala {
    font-family: var(--rotulo);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--tenue);
  }
  .sala::before {
    content: "●";
    margin-right: 8px;
    color: var(--seccion);
  }
  .sala:hover {
    color: var(--texto);
  }
  h1 {
    margin-top: 10px;
    font-size: clamp(2rem, 5vw, 3.3rem);
    line-height: 1.08;
    overflow-wrap: anywhere;
  }
  .autor {
    margin: 12px 0 0;
    font-size: 1.15rem;
    color: var(--tenue);
  }
  .autor a {
    color: var(--texto);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--texto) 30%, transparent);
    text-underline-offset: 4px;
  }
  .autor a:hover {
    text-decoration-color: currentColor;
  }
  .sellos {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .sello {
    padding: 5px 13px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--caja) 75%, transparent);
    border: 1px solid var(--borde);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .sello small {
    color: var(--tenue);
    font-weight: 400;
  }
  .sello.dorado {
    color: var(--dorado);
    border-color: color-mix(in srgb, var(--dorado) 45%, transparent);
  }
  .sello.tenue {
    color: var(--tenue);
    font-weight: 400;
  }
  /* Lo que solo se ve en el vistazo: borrador, oculta o privada. */
  .sello.marca {
    background: var(--enlace);
    border-color: var(--enlace);
    color: var(--fondo);
  }
  a.sello:hover {
    border-color: var(--suave);
  }
  .tags,
  .grupos {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  .grupos {
    margin-bottom: 0;
  }
  /* Un grupo lo hace el dueño y un tag lo pone la fuente: el grupo va con
     borde de su tinta, el tag con el gris de siempre. */
  .chip.grupo {
    color: var(--texto);
    border-color: var(--suave);
  }
  .fuentes {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin: 16px 0 0;
    font-size: 0.92rem;
  }
  .fuentes a {
    color: var(--enlace);
  }
  .fuentes a:hover {
    color: var(--texto);
  }
  /* El color de la portada tiñe la luz del escaparate, el filo de la cartela
     y los botones del reproductor. Solo en lo que no es texto: un color que
     sale de una imagen no garantiza contraste con nada. */
  .tenida .escaparate {
    background: linear-gradient(180deg, color-mix(in srgb, var(--tinte) 26%, transparent), transparent 85%);
  }
  .tenida .texto :global(.callout[data-callout="vitrina"]),
  .tenida .texto :global(.callout[data-callout="vitrine"]) {
    border-left-color: var(--tinte);
  }
  .reproducir {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0 0;
  }
  .tocar {
    padding: 8px 16px;
    border: 1px solid color-mix(in srgb, var(--tinte, var(--seccion)) 70%, var(--borde));
    border-radius: 999px;
    background: color-mix(in srgb, var(--tinte, var(--seccion)) 16%, var(--caja));
    color: var(--texto);
    font: inherit;
    font-weight: 600;
    font-size: 0.92rem;
    cursor: pointer;
  }
  .tocar:hover,
  .tocar[aria-expanded="true"] {
    background: color-mix(in srgb, var(--tinte, var(--seccion)) 30%, var(--caja));
  }
  /* Con el disco abierto, la portada se queda arriba en vez de bajar con él. */
  .dentro:has(.spotify:not([hidden])) .cubierta {
    align-self: flex-start;
  }
  .spotify {
    margin-top: 14px;
    max-width: 560px;
  }
  .spotify :global(iframe) {
    display: block;
    width: 100%;
    height: 352px;
    border: 0;
    border-radius: 12px;
  }
  .trailer {
    width: min(960px, calc(100vw - 32px));
    padding: 0;
    border: 0;
    border-radius: var(--radio);
    background: #000;
    overflow: visible;
  }
  .trailer::backdrop {
    background: rgb(0 0 0 / 0.8);
  }
  .trailer .pantalla {
    aspect-ratio: 16 / 9;
  }
  .trailer :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: var(--radio);
  }
  .cerrar {
    position: absolute;
    top: -44px;
    right: 0;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.15);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .compartir {
    padding: 0;
    border: 0;
    background: none;
    color: var(--enlace);
    font: inherit;
    cursor: pointer;
  }
  .compartir:hover {
    color: var(--texto);
  }
  .pasos {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--borde);
  }
  .pasos a {
    display: flex;
    flex-direction: column;
    max-width: 45%;
    font-weight: 600;
  }
  .pasos a:hover {
    color: var(--enlace);
  }
  .pasos small {
    color: var(--tenue);
    font-weight: 400;
  }
  .pasos .derecha {
    text-align: right;
    margin-left: auto;
  }
  .texto {
    max-width: 760px;
    padding-top: 44px;
  }
  .texto :global(h2) {
    margin: 36px 0 12px;
    font-family: var(--rotulo);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .texto :global(ol) {
    columns: 2;
    column-gap: 40px;
    color: var(--tenue);
    padding-left: 1.6em;
  }
  .texto :global(ol li) {
    break-inside: avoid;
  }
  @media (max-width: 680px) {
    .escaparate {
      padding-block: 28px;
    }
    .dentro {
      flex-direction: column;
      align-items: flex-start;
      gap: 22px;
    }
    .cubierta {
      width: 160px;
    }
    .cubierta.cuadrada {
      width: 200px;
    }
    .texto :global(ol) {
      columns: 1;
    }
  }
</style>
