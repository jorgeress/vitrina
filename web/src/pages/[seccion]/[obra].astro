---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Portada from "../../components/Portada.astro";
import { DUENO } from "../../config";
import { t } from "../../i18n";
import {
  autores,
  autoresRepetidos,
  opinion,
  enlaceEditar,
  colorPortada,
  fechaParcial,
  fuentes,
  grupos,
  marcas,
  mesYAño,
  nombreTag,
  obras,
  porAlta,
  portada,
  relacionadas,
  relaciones,
  ruta,
  rutaAutor,
  rutaFija,
  rutaGrupo,
  slugsAutores,
  rutaTag,
  seccionDe,
  slugObra,
  tarjeta,
  titulo,
  transicion,
  url,
  type Obra,
  type Tipo,
  type Vecina,
} from "../../lib/obras";

export async function getStaticPaths() {
  const todas = await obras();
  return todas.map((obra) => ({
    params: { seccion: seccionDe(obra.data.type).slug, obra: slugObra(obra) },
    props: { obra, todas },
  }));
}

const { obra, todas } = Astro.props as { obra: Obra; todas: Obra[] };
const d = obra.data;
const seccion = seccionDe(d.type);
const nombre = titulo(obra);
const imagen = portada(obra);
const { Content } = await render(obra);
const cercanas = relacionadas(obra, todas);
const conPagina = autoresRepetidos(todas);
const slugs = await slugsAutores();
const quienes = autores(obra);
const enlaces = fuentes(obra);
const escrita = opinion(obra);
const editar = enlaceEditar(obra);
// Anterior y siguiente dentro de la sala, en el orden en que entraron: el
// mismo de la rejilla, así que pasar de una a otra es recorrerla.
const sala = todas.filter((o) => o.data.type === d.type).sort(porAlta);
const posicion = sala.findIndex((o) => o.id === obra.id);
const anterior = sala[posicion - 1];
const siguiente = sala[posicion + 1];

// Lo que leen los buscadores: qué es la obra y, si hay nota o opinión, una
// reseña mía con ellas.
const TIPOS_SCHEMA = { game: "VideoGame", film: "Movie", series: "TVSeries", book: "Book", album: "MusicAlbum" } as Record<string, string>;
// Quien firma un disco es un grupo y un juego lo firma un estudio; lo demás,
// personas.
const TIPO_CREADOR = { album: "MusicGroup", game: "Organization" } as Record<string, string>;
const creadores = quienes.map((n) => ({ "@type": TIPO_CREADOR[d.type] ?? "Person", name: n }));
const datosEstructurados = {
  "@context": "https://schema.org",
  "@type": TIPOS_SCHEMA[d.type],
  name: nombre,
  ...(imagen && { image: new URL(imagen, Astro.site).href }),
  ...(d.year && { datePublished: String(d.year) }),
  ...(creadores.length && (d.type === "album" ? { byArtist: creadores } : d.type === "film" ? { director: creadores } : { author: creadores })),
  ...(d.tags?.length && { genre: d.tags.map(nombreTag) }),
  ...((d.rating || escrita) && {
    review: {
      "@type": "Review",
      author: { "@type": "Person", name: DUENO },
      ...(d.rating && { reviewRating: { "@type": "Rating", ratingValue: d.rating, bestRating: 10, worstRating: 1 } }),
      ...(escrita && { reviewBody: escrita }),
    },
  }),
};

const resumen = escrita ?? t.resumenFicha(`${nombre}${d.year ? ` (${d.year})` : ""}`, seccion.nombre);
const tinte = await colorPortada(obra);
const historia = relaciones(obra, todas);
const suyos = (await grupos()).filter((g) => g.obras.some((o) => o.id === obra.id));
const marcadas = marcas(obra);

/** Por qué está unida: el autor que comparten o sus dos tags más raros. */
function motivo(v: Vecina): string {
  const [primero, segundo] = v.motivos;
  if (!primero) return "";
  if (quienes.includes(primero)) return t.tambienDe(primero);
  return [primero, segundo].filter(Boolean).map((t) => nombreTag(t!)).join(" · ");
}
---

<Base titulo={nombre} descripcion={resumen} imagen={tarjeta(obra)} activa={seccion.slug}>
  <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />
  <article style={`--seccion:var(--${d.type})${tinte ? `;--tinte:${tinte}` : ""}`} class:list={[tinte && "tenida"]} data-pagefind-body>
    <header class="escaparate">
      {imagen && <div class="fondo" style={`background-image:url('${imagen}')`} aria-hidden="true" />}
      <div class="contenedor dentro">
        <div
          class:list={["cubierta", d.type === "album" && "cuadrada", d.status === "dropped" && "retirada"]}
          style={`view-transition-name:${transicion(obra)}`}
        >
          {
            imagen ? (
              <img src={imagen} alt={t.portadaDe(nombre)} data-pagefind-meta="image[src]" />
            ) : (
              <span class="sin-imagen">{nombre}</span>
            )
          }
        </div>
        <div class="datos">
          <a class="sala" href={url(`${seccion.slug}/`)} data-pagefind-filter="sala">{seccion.nombre}</a>
          <h1 data-pagefind-meta="title">{nombre}</h1>
          <p class="autor">
            {
              // Cada autor por separado, enlazado si tiene página: en «QLOC,
              // FromSoftware, Inc.» solo FromSoftware la tiene.
              quienes.map((a, i) => (
                <>
                  {i > 0 && (i === quienes.length - 1 ? ` ${t.y} ` : ", ")}
                  {conPagina.has(a) ? <a href={rutaAutor(a, slugs)}>{a}</a> : <span>{a}</span>}
                </>
              ))
            }
            {quienes.length > 0 && d.year && <span class="punto"> · </span>}
            {d.year}
          </p>
          <div class="sellos">
            {marcadas.map((m) => <span class="sello marca">{t[m]}</span>)}
            {d.favorite && <a class="sello dorado" href={rutaFija("favoritos")}>★ {t.mejor}</a>}
            {d.rating && <span class="sello">{d.rating}<small>/10</small></span>}
            {d.status && <span class="sello">{t.estados[d.status]}</span>}
            {d.times && d.times > 1 && <span class="sello">{t.veces(d.type as Tipo, d.times)}</span>}
            {
              d.finished_on && (
                <a class="sello" href={rutaFija("anuario", `${d.finished_on.slice(0, 4)}/`)}>
                  {t.terminadaEn(fechaParcial(d.finished_on))}
                </a>
              )
            }
            {
              // El empezado solo si no hay terminado del mismo año: «Empezado
              // en marzo de 2024» al lado de «Terminado en mayo de 2024» repite.
              d.started_on && d.started_on.slice(0, 4) !== d.finished_on?.slice(0, 4) && (
                <a class="sello" href={rutaFija("anuario", `${d.started_on.slice(0, 4)}/`)}>
                  {t.empezadaEn(d.type as Tipo, fechaParcial(d.started_on))}
                </a>
              )
            }
            {d.added && <span class="sello tenue">{t.desde(mesYAño(d.added))}</span>}
          </div>
          {
            (d.tags?.length ?? 0) > 0 && (
              <div class="tags">
                {d.tags!.map((t) => (
                  <a class="chip" href={rutaTag(t)}>
                    {nombreTag(t)}
                  </a>
                ))}
              </div>
            )
          }
          {
            suyos.length > 0 && (
              <p class="grupos" aria-label={t.enGrupos}>
                {suyos.map((g) => (
                  <a class="chip grupo" href={rutaGrupo(g)}>
                    ◇ {g.nombre}
                  </a>
                ))}
              </p>
            )
          }
          <p class="fuentes">
            {enlaces.map((f) => (
              <a href={f.href} rel="noopener">
                {f.nombre} ↗
              </a>
            ))}
            <button type="button" class="compartir" id="compartir" hidden data-titulo={nombre} data-compartir={t.compartir} data-copiado={t.copiado}>
              {t.compartir}
            </button>
            {
              // Solo para el dueño: sale si en este navegador se ha pedido desde
              // la página de añadir. A cualquier otro no le hace nada (la Action
              // solo atiende Issues del dueño), pero no pinta nada en la ficha.
              editar && (
                <a class="editar" id="editar" href={editar} title={t.editarTitulo} hidden>
                  ✎ {t.editar}
                </a>
              )
            }
          </p>
        </div>
      </div>
    </header>

    <div class="contenedor texto">
      <Content />
    </div>
  </article>

  {
    historia.length > 0 && (
      <section class="contenedor bloque" aria-labelledby="t-historia">
        <header>
          <div>
            <h2 id="t-historia">{t.mismaHistoria}</h2>
            <p>{t.mismaHistoriaSub}</p>
          </div>
        </header>
        <div class="rejilla">
          {historia.map((r) => (
            <Portada obra={r.obra} mixta nota={t.relaciones[r.tipo]} />
          ))}
        </div>
      </section>
    )
  }


  {
    cercanas.length > 0 && (
      <section class="contenedor bloque" aria-labelledby="t-conectada">
        <header>
          <div>
            <h2 id="t-conectada">{t.conectada}</h2>
            <p>{t.conectadaSub}</p>
          </div>
          <a class="ver-todo" href={rutaFija("constelacion", `?foco=${encodeURIComponent(obra.id)}`)}>
            {t.enConstelacion}
          </a>
        </header>
        <div class="rejilla">
          {cercanas.map((v) => (
            <Portada obra={v.obra} mixta nota={motivo(v)} />
          ))}
        </div>
      </section>
    )
  }

  <nav class="contenedor pasos" aria-label={t.masDe(seccion.nombre)}>
    {
      anterior ? (
        <a href={ruta(anterior)} rel="prev" id="anterior">
          <small>{t.anterior}</small>
          {titulo(anterior)}
        </a>
      ) : (
        <span />
      )
    }
    {
      siguiente && (
        <a href={ruta(siguiente)} rel="next" id="siguiente" class="derecha">
          <small>{t.siguiente}</small>
          {titulo(siguiente)}
        </a>
      )
    }
  </nav>
</Base>

<script>
  // Compartir con lo que tenga el sistema (en el móvil, su menú); si no hay,
  // copiar el enlace.
  const boton = document.getElementById("compartir") as HTMLButtonElement;
  if (navigator.share || navigator.clipboard) {
    boton.hidden = false;
    boton.addEventListener("click", async () => {
      const datos = { title: boton.dataset.titulo, url: location.href.split("?")[0] };
      try {
        if (navigator.share) await navigator.share(datos);
        else {
          await navigator.clipboard.writeText(datos.url);
          boton.textContent = boton.dataset.copiado!;
          setTimeout(() => (boton.textContent = boton.dataset.compartir!), 2000);
        }
      } catch {}
    });
  }

  try {
    if (localStorage.getItem("vitrina:editar") === "1") document.getElementById("editar")?.removeAttribute("hidden");
  } catch {}

  // Las flechas del teclado pasan a la anterior y la siguiente de la sala.
  document.addEventListener("keydown", (e) => {
    if ((e.target as HTMLElement).closest("input, textarea, select") || e.metaKey || e.ctrlKey || e.altKey) return;
    const destino = e.key === "ArrowLeft" ? "anterior" : e.key === "ArrowRight" ? "siguiente" : null;
    const enlace = destino && (document.getElementById(destino) as HTMLAnchorElement | null);
    if (enlace) location.href = enlace.href;
  });
</script>

<style>
  .escaparate {
    position: relative;
    overflow: hidden;
    padding-block: 52px;
    border-bottom: 1px solid var(--borde);
  }
  /* La propia portada, desenfocada, hace de fondo: cada ficha tiene su luz
     sin elegirla a mano, como una pieza iluminada dentro de su caja. */
  .fondo {
    position: absolute;
    inset: -40px;
    background-size: cover;
    background-position: center;
    filter: blur(52px) saturate(1.2);
    opacity: 0.3;
  }
  .dentro {
    position: relative;
    display: flex;
    gap: 44px;
    align-items: flex-end;
  }
  .cubierta {
    flex: none;
    width: 250px;
    aspect-ratio: 2 / 3;
    border-radius: var(--radio);
    overflow: hidden;
    background: var(--caja-2);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.45);
  }
  .cubierta.cuadrada {
    width: 290px;
    aspect-ratio: 1;
  }
  .cubierta.retirada {
    filter: grayscale(0.85);
  }
  .cubierta img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sin-imagen {
    display: flex;
    align-items: flex-end;
    height: 100%;
    padding: 20px;
    font-family: var(--rotulo);
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1.1;
    background:
      radial-gradient(circle at 20% 15%, color-mix(in srgb, var(--seccion) 45%, transparent), transparent 60%),
      linear-gradient(160deg, color-mix(in srgb, var(--seccion) 25%, var(--caja-2)), var(--caja-2));
  }
  .sala {
    font-family: var(--rotulo);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--tenue);
  }
  .sala::before {
    content: "●";
    margin-right: 8px;
    color: var(--seccion);
  }
  .sala:hover {
    color: var(--texto);
  }
  h1 {
    margin-top: 10px;
    font-size: clamp(2rem, 5vw, 3.3rem);
    line-height: 1.08;
    overflow-wrap: anywhere;
  }
  .autor {
    margin: 12px 0 0;
    font-size: 1.15rem;
    color: var(--tenue);
  }
  .autor a {
    color: var(--texto);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--texto) 30%, transparent);
    text-underline-offset: 4px;
  }
  .autor a:hover {
    text-decoration-color: currentColor;
  }
  .sellos {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .sello {
    padding: 5px 13px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--caja) 75%, transparent);
    border: 1px solid var(--borde);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .sello small {
    color: var(--tenue);
    font-weight: 400;
  }
  .sello.dorado {
    color: var(--dorado);
    border-color: color-mix(in srgb, var(--dorado) 45%, transparent);
  }
  .sello.tenue {
    color: var(--tenue);
    font-weight: 400;
  }
  /* Lo que solo se ve en el vistazo: borrador, oculta o privada. */
  .sello.marca {
    background: var(--enlace);
    border-color: var(--enlace);
    color: var(--fondo);
  }
  a.sello:hover {
    border-color: var(--suave);
  }
  .tags,
  .grupos {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  .grupos {
    margin-bottom: 0;
  }
  /* Un grupo lo hace el dueño y un tag lo pone la fuente: el grupo va con
     borde de su tinta, el tag con el gris de siempre. */
  .chip.grupo {
    color: var(--texto);
    border-color: var(--suave);
  }
  .fuentes {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin: 16px 0 0;
    font-size: 0.92rem;
  }
  .fuentes a {
    color: var(--enlace);
  }
  .fuentes a:hover {
    color: var(--texto);
  }
  /* El color de la portada tiñe la luz del escaparate y el filo de la
     opinión. Solo en lo que no es texto: un color que
     sale de una imagen no garantiza contraste con nada. */
  .tenida .escaparate {
    background: linear-gradient(180deg, color-mix(in srgb, var(--tinte) 26%, transparent), transparent 85%);
  }
  .tenida .texto :global(.callout[data-callout="vitrina"]),
  .tenida .texto :global(.callout[data-callout="vitrine"]) {
    border-left-color: var(--tinte);
  }
  .compartir {
    padding: 0;
    border: 0;
    background: none;
    color: var(--enlace);
    font: inherit;
    cursor: pointer;
  }
  .editar {
    color: var(--enlace);
  }
  .editar:hover,
  .compartir:hover {
    color: var(--texto);
  }
  .pasos {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--borde);
  }
  .pasos a {
    display: flex;
    flex-direction: column;
    max-width: 45%;
    font-weight: 600;
  }
  .pasos a:hover {
    color: var(--enlace);
  }
  .pasos small {
    color: var(--tenue);
    font-weight: 400;
  }
  .pasos .derecha {
    text-align: right;
    margin-left: auto;
  }
  .texto {
    max-width: 760px;
    padding-top: 44px;
  }
  .texto :global(h2) {
    margin: 36px 0 12px;
    font-family: var(--rotulo);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .texto :global(ol) {
    columns: 2;
    column-gap: 40px;
    color: var(--tenue);
    padding-left: 1.6em;
  }
  .texto :global(ol li) {
    break-inside: avoid;
  }
  @media (max-width: 680px) {
    .escaparate {
      padding-block: 28px;
    }
    .dentro {
      flex-direction: column;
      align-items: flex-start;
      gap: 22px;
    }
    .cubierta {
      width: 160px;
    }
    .cubierta.cuadrada {
      width: 200px;
    }
    .texto :global(ol) {
      columns: 1;
    }
  }
</style>
