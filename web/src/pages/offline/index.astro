---
import Base from "../../layouts/Base.astro";
import { t } from "../../i18n";
import { url } from "../../lib/obras";
---

<Base titulo={t.sinConexion}>
  <div class="contenedor aviso">
    <p class="rotulo">{t.sinConexion}</p>
    <h1>{t.sinConexionTitulo}</h1>
    <p>{t.sinConexionTexto}</p>
    <p><a href={url()}>{t.irEntrada}</a></p>
  </div>
</Base>

<style>
  .aviso {
    padding-block: 96px;
    text-align: center;
  }
  .rotulo {
    color: var(--tenue);
    font-size: 0.85rem;
  }
  h1 {
    margin-top: 10px;
    font-family: var(--rotulo);
    font-weight: 600;
    font-size: clamp(1.8rem, 5vw, 2.6rem);
  }
  p {
    color: var(--tenue);
  }
  a {
    color: var(--enlace);
  }
</style>
