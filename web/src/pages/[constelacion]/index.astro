---
import Base from "../../layouts/Base.astro";
import { t } from "../../i18n";
import { SECCIONES, autores, flechas, nombreTag, obras, portada, ruta, titulo, vecindario } from "../../lib/obras";

export const getStaticPaths = () => [{ params: { constelacion: t.rutas.constelacion } }];

// Los nodos son las obras y las aristas, lo que tienen en común. Cada obra se
// une a sus tres más parecidas y, siempre, a las de su mismo autor: con todas
// las parejas posibles saldría una bola sin forma; con pocas, se ven grupos.
// La que no se parece a nada se une a las de su sección más cercanas en el
// tiempo, con una arista débil que se pinta discontinua.
//
// Encima de las obras hay dos niveles más, que se calculan en el navegador
// con estos mismos datos: las salas y los géneros (los tags que más se
// repiten). Se baja pulsando una burbuja y se sube con el botón.
const todas = await obras();
const vecinas = vecindario(todas, 3);
type Arista = { source: string; target: string; peso: number; debil: boolean; relacion?: string };
const aristas = new Map<string, Arista>();
const unir = (a: string, b: string, peso: number, debil: boolean) => {
  const clave = [a, b].sort().join("|");
  const previa = aristas.get(clave);
  if (!previa || (previa.debil && !debil)) aristas.set(clave, { ...previa, source: a, target: b, peso, debil });
};
for (const a of todas) for (const v of vecinas.get(a.id) ?? []) unir(a.id, v.obra.id, v.peso, v.debil);
const porAutor = new Map<string, string[]>();
for (const o of todas) for (const autor of autores(o)) porAutor.set(autor, [...(porAutor.get(autor) ?? []), o.id]);
for (const ids of porAutor.values())
  for (let i = 0; i < ids.length; i++) for (let j = i + 1; j < ids.length; j++) unir(ids[i], ids[j], 6, false);
// Lo que es de la misma historia pesa más que cualquier parecido y lleva
// sentido: la arista va de la obra de la que sale a la que sale de ella.
for (const { desde, hacia, campo } of flechas(todas))
  aristas.set([desde.id, hacia.id].sort().join("|"), { source: desde.id, target: hacia.id, peso: 10, debil: false, relacion: campo });
const hayFlechas = [...aristas.values()].some((a) => a.relacion);

const datos = {
  nodos: todas.map((o) => ({
    id: o.id,
    titulo: titulo(o),
    tipo: o.data.type,
    favorito: Boolean(o.data.favorite),
    portada: portada(o),
    url: ruta(o),
    tags: o.data.tags ?? [],
  })),
  aristas: [...aristas.values()],
  salas: SECCIONES.map((s) => ({ tipo: s.tipo, nombre: s.nombre })),
  nombresTag: Object.fromEntries([...new Set(todas.flatMap((o) => o.data.tags ?? []))].map((tag) => [tag, nombreTag(tag)])),
  textos: { ...t.nivelesTexto, obras: t.constelacionTexto(todas.length), niveles: t.niveles, todas: t.todasLasSalas },
};
---

<Base titulo={t.constelacion} descripcion={t.constelacionDescripcion} activa="constelacion">
  <div class="escena">
    <canvas id="lienzo" aria-label={t.constelacionLienzo}></canvas>
    <div class="panel">
      <h1>{t.constelacion}</h1>
      <div class="niveles" role="group" aria-label={t.constelacion}>
        {(["salas", "generos", "obras"] as const).map((n) => <button type="button" data-nivel={n}>{t.niveles[n]}</button>)}
      </div>
      <p class="migas" id="migas">
        <button type="button" id="subir" hidden>{t.subir}</button>
        <span id="camino"></span>
      </p>
      <p id="texto-nivel">{t.constelacionTexto(datos.nodos.length)}</p>
      <input id="buscar" type="search" list="titulos" placeholder={t.buscarObra} aria-label={t.buscarObra} />
      <datalist id="titulos">
        {datos.nodos.map((n) => <option value={n.titulo} />)}
      </datalist>
      {hayFlechas && <p class="flechas" id="nota-flechas">{t.flechasLeyenda}</p>}
      <div class="leyenda" id="leyenda">
        {
          SECCIONES.map((s) => (
            <button type="button" data-tipo={s.tipo} class="activo" style={`--seccion:var(--${s.tipo})`}>
              <span /> {s.nombre}
            </button>
          ))
        }
      </div>
    </div>
  </div>
  <script type="application/json" id="datos" set:html={JSON.stringify(datos)} />
</Base>

<script>
  import { iniciar } from "../../scripts/constelacion";
  iniciar();
</script>

<style>
  .escena {
    position: relative;
    height: calc(100dvh - 61px);
    overflow: hidden;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
  }
  canvas.agarrado {
    cursor: grabbing;
  }
  .panel {
    position: absolute;
    top: 20px;
    left: 20px;
    max-width: 320px;
    padding: 16px 18px;
    border-radius: var(--radio);
    background: color-mix(in srgb, var(--caja) 90%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid var(--borde);
  }
  h1 {
    font-family: var(--rotulo);
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: 0.04em;
  }
  .panel p {
    margin: 6px 0 12px;
    color: var(--tenue);
    font-size: 0.86rem;
  }
  #buscar {
    width: 100%;
    margin-bottom: 12px;
    padding: 8px 10px;
    border: 1px solid var(--borde);
    border-radius: 8px;
    background: var(--fondo);
    color: var(--texto);
    font: inherit;
    font-size: 0.88rem;
  }
  .niveles {
    display: flex;
    margin: 10px 0 4px;
    border: 1px solid var(--borde);
    border-radius: 999px;
    overflow: hidden;
  }
  .niveles button {
    flex: 1;
    padding: 5px 8px;
    border: 0;
    background: none;
    color: var(--tenue);
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
  }
  .niveles button + button {
    border-left: 1px solid var(--borde);
  }
  .niveles button[aria-pressed="true"] {
    background: var(--texto);
    color: var(--fondo);
    font-weight: 600;
  }
  .panel .migas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    min-height: 1.6em;
    margin: 8px 0 0;
    color: var(--texto);
    font-size: 0.86rem;
    font-weight: 600;
  }
  .panel .migas:not(:has(#subir:not([hidden]))):has(#camino:empty) {
    display: none;
  }
  #subir {
    padding: 2px 10px;
    border: 1px solid var(--borde);
    border-radius: 999px;
    background: var(--fondo);
    color: var(--texto);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .panel p.flechas {
    margin-top: -4px;
  }
  .leyenda[hidden],
  .flechas[hidden] {
    display: none;
  }
  .leyenda {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .leyenda button {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid var(--borde);
    border-radius: 999px;
    background: none;
    color: var(--tenue);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .leyenda button span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--seccion);
  }
  .leyenda button[data-tipo="album"] span {
    border-radius: 2px;
  }
  .leyenda button.activo {
    color: var(--texto);
    border-color: var(--seccion);
  }
  .leyenda button:not(.activo) span {
    opacity: 0.3;
  }
  @media (max-width: 760px) {
    .escena {
      height: calc(100dvh - 61px - 64px);
    }
    .panel {
      top: 10px;
      left: 10px;
      right: 10px;
      max-width: none;
      padding: 12px;
    }
    .panel p:not(.migas) {
      display: none;
    }
  }
</style>
