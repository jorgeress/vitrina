---
import Base from "../layouts/Base.astro";
import { t } from "../i18n";
import { rutaFija, url } from "../lib/obras";
---

<Base titulo={t.vacia}>
  <div class="contenedor aviso">
    <p class="rotulo">404</p>
    <h1>{t.vacia}</h1>
    <p>{t.vaciaTexto}</p>
    <p>
      <a href={rutaFija("buscar")}>{t.buscarlo}</a> · <a href={url()}>{t.irEntradaCorto}</a>
    </p>
  </div>
</Base>

<style>
  .aviso {
    padding-block: 96px;
    text-align: center;
  }
  .rotulo {
    color: var(--tenue);
    font-size: 0.85rem;
  }
  h1 {
    margin-top: 10px;
    font-family: var(--rotulo);
    font-weight: 600;
    font-size: clamp(1.8rem, 5vw, 2.6rem);
  }
  p {
    color: var(--tenue);
  }
  a {
    color: var(--enlace);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
