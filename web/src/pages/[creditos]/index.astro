---
import { getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { t } from "../../i18n";

export const getStaticPaths = () => [{ params: { creditos: t.rutas.creditos } }];

// La página de créditos es una nota de la vault: creditos.md o credits.md.
const pagina = ((await getEntry("paginas", "creditos")) ?? (await getEntry("paginas", "credits")))!;
const { Content } = await render(pagina);
---

<Base titulo={pagina.data.title}>
  <article class="contenedor texto">
    <header class="titulo-pagina">
      <h1>{pagina.data.title}</h1>
    </header>
    <Content />
  </article>
</Base>

<style>
  .texto {
    max-width: 720px;
  }
  .texto :global(.titulo-pagina) {
    margin-bottom: 24px;
  }
  .texto :global(a) {
    color: var(--enlace);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
