---
import Base from "../../layouts/Base.astro";
import { autoresRepetidos, cantidad, obras, portada, rutaAutor, slugsAutores } from "../../lib/obras";

// Solo quien tiene dos obras o más, como en la vault: con una sola, la página
// de autor no agrupa nada que no diga ya la ficha.
const slugs = await slugsAutores();
const grupos = [...autoresRepetidos(await obras())].sort(
  (a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0], "es"),
);
---

<Base titulo="Autores" descripcion="Quien firma más de una pieza de la vitrina.">
  <div class="contenedor">
    <header class="titulo-pagina">
      <h1>Autores</h1>
      <p>Quien firma más de una pieza de la vitrina.</p>
    </header>
    <ul class="lista">
      {
        grupos.map(([autor, lista]) => (
          <li>
            <a href={rutaAutor(autor, slugs)}>
              <span class="miniaturas" aria-hidden="true">
                {lista.slice(0, 3).map((o) =>
                  portada(o) ? <img src={portada(o)} alt="" loading="lazy" /> : <span class="hueco" style={`background:var(--${o.data.tipo})`} />,
                )}
              </span>
              <span>
                <strong>{autor}</strong>
                <small>{cantidad(lista.length, "pieza", "piezas")}</small>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .lista {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 12px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
  .lista a {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px;
    border-radius: var(--radio);
    background: var(--caja);
    border: 1px solid var(--borde);
  }
  .lista a:hover {
    border-color: var(--suave);
  }
  .miniaturas {
    display: flex;
    flex: none;
  }
  .miniaturas > * {
    display: block;
    width: 40px;
    height: 56px;
    object-fit: cover;
    border-radius: 5px;
    border: 2px solid var(--caja);
  }
  .miniaturas > * + * {
    margin-left: -18px;
  }
  .hueco {
    opacity: 0.5;
  }
  strong {
    display: block;
    font-weight: 600;
  }
  small {
    color: var(--tenue);
    font-size: 0.88rem;
  }
</style>
