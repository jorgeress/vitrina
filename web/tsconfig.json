{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "vistazo"],
  "compilerOptions": {
    // Las pruebas corren con node --test, que quita los tipos al vuelo pero
    // necesita la extensión .ts en los import.
    "allowImportingTsExtensions": true
  }
}
